# =====================================================
# KONFIGURASI TELEGRAM USERBOT
# Copy file ini ke ".env" lalu isi nilainya
# =====================================================

# Dari https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Session akun utama (generate: npm run login) — atau pakai file session.txt
SESSION_STRING=

# OPSIONAL — panel dengan tombol inline (buat bot lewat @BotFather, lalu tempel token di sini)
# Telegram tidak mengizinkan akun user mengirim tombol, jadi tombol dikirim lewat bot ini.
BOT_TOKEN=

# OPSIONAL
# BOT_BRAND=ARTA USERBOT
# DATA_DIR=./data
